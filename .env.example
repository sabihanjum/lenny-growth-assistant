# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="The Lenny Growth Assistant"
DEBUG=false

# Database Configuration (PostgreSQL 16 with pgvector)
# For local development outside docker:
DATABASE_URL=postgresql+asyncpg://postgres:password123@localhost:5432/lenny_assistant
# For Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:password123@db:5432/lenny_assistant

# LLM Providers Configuration
# Default options: 'ollama', 'claude', 'openai'
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Cloud LLM API Keys (Optional - required only when switching to Cloud in UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# RAG & Retrieval Parameters
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.55

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
